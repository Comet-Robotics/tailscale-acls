{
	// The tailnet is configured such that, by default, regular members are only able to access their own devices unless we 
	// explicitly add grants in this block which give them more access permissions. Tailscale admins are implicitly granted
	// full access to all devices, so we don't need to mention them in any grants here.
	"grants": [
		// Only allow CROUTON Committee (Comet Robotics Office of Unified Technology, Operations, and Networking) members to access
		// CROUTON devices over the network - most notably for managing the server that hosts portal.cometrobotics.org.
		{
			"src": ["group:crouton-committee"],
			"dst": ["tag:crouton-devices"],
			"ip":  ["*"],
		},
		// Allow CROUTON Committee members to reach the lab LAN (192.168.1.0/24) through the
		// subnet router (ryan). Without this grant, the control plane strips the subnet route
		// from clients' netmaps, so the route never reaches them even when approved.
		{
			"src": ["group:crouton-committee"],
			"dst": ["192.168.1.0/24"],
			"ip":  ["*"],
		},
		// Only allow VEX U project team members to access VEX devices. Will be used for remote access to team's Jetson Nano machines.
		{
			"src": ["group:vex"],
			"dst": ["tag:vex-devices"],
			"ip":  ["*"],
		},
		// Allow any member of the tailnet to access 'public' devices.
		{
			"src": ["autogroup:member"],
			"dst": ["tag:public-devices"],
			"ip":  ["*"],
		},
	],

	"ssh": [
		// Allow all users to SSH into their own devices in check mode.
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
		// Allow CROUTON Committee members to SSH into any CROUTON device as any user.
		{
			"action": "accept",
			"src":    ["group:crouton-committee"],
			"dst":    ["tag:crouton-devices"],
			"users":  ["autogroup:nonroot", "root"],
		},
		// Allow VEX team members to SSH into any VEX device as any user.
		{
			"action": "accept",
			"src":    ["group:vex"],
			"dst":    ["tag:vex-devices"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],

	"nodeAttrs": [
		{
			// Funnel policy, which lets tailnet members control Funnel
			// for their own devices.
			// Learn more at https://tailscale.com/kb/1223/tailscale-funnel/
			"target": ["autogroup:member"],
			"attr": ["funnel"],
		},
	],

	"groups": {
		"group:crouton-committee": [
			"jasonappah@github",
			"pederjohnson@github",
			"democat3457@github"
		],

		"group:vex": [
			"j5155@github",
			"Udunen@github",
			"kevalshah2005@github",
			"CometVEXU@github",
			"isaacabrown6844@gmail.com",
			"chhudson1855@github",
		],
	},

	// The tag owners block has two purposes
	// 1. The key defines tags which can be applied to devices in the Tailscale console
	// 2. The associated array value defines a list of users are able to apply this tag to devices. Users are only able to tag devices
	// 	  that they 'own' - meaning their Tailscale user added it to the tailned.
	"tagOwners": {
		// Tag for devices which only CROUTON Committee members should have access to.
		"tag:crouton-devices": [
			"group:crouton-committee",
		],

		// Tag for devices which Allows VEX team members to grant other team members access to devices they own over the tailnet.
		"tag:vex-devices": [
			"group:vex",
		],

		// Devices which should be shared with all members of the tailnet. Any member of the tailnet can apply this to their 
        // own device if they want other members of the tailnet to be able to access their device over Tailscale. Keep in mind, doing this opens
		// up your device for remote network access by *anyone who is a member of the GitHub organization* using *any port or protocol*.
		"tag:public-devices": [
			"autogroup:member",
		],
	},

	// Subnet routes approved automatically when advertised by CROUTON Committee members,
	// so re-advertising after a reinstall doesn't require a manual console approval.
	"autoApprovers": {
		"routes": {
			"192.168.1.0/24": ["group:crouton-committee", "tag:crouton-devices"],
		},
	},

	// Test access rules every time they're saved.
	// "tests": [
	//   {
	//       "src": "alice@example.com",
	//       "accept": ["tag:example"],
	//       "deny": ["100.101.102.103:443"],
	//   },
	// ],
}
